# Persistent Agent service configuration.
# Installed as /etc/wifi-experience-agent/agent.env by agent/install.sh.

WEM_AGENT_SERVER_URL="http://127.0.0.1:8000"
WEM_AGENT_ENROLLMENT_TOKEN="replace-me"
WEM_AGENT_DATA_DIR="/var/lib/wifi-experience-agent"
WEM_AGENT_NAME="sensor-local-01"
WEM_AGENT_TYPE="sensor"
WEM_AGENT_INTERFACE="wlp0s20f3"

# Optional runtime tuning. Defaults come from AgentSettings when omitted.
# WEM_AGENT_HEARTBEAT_INTERVAL_SECONDS="5"
# WEM_AGENT_STATE_INTERVAL_SECONDS="5"
# WEM_AGENT_TELEMETRY_SAMPLE_INTERVAL_SECONDS="1"
# WEM_AGENT_TELEMETRY_WINDOW_SECONDS="10"
# WEM_AGENT_TELEMETRY_SYNC_INTERVAL_SECONDS="5"
# WEM_AGENT_TELEMETRY_RETENTION_HOURS="24"
# WEM_AGENT_REQUEST_TIMEOUT_SECONDS="10"
# WEM_AGENT_SYNTHETIC_PROBE_INTERVAL_SECONDS="5"
# WEM_AGENT_SYNTHETIC_PROBE_TIMEOUT_SECONDS="6"
# WEM_AGENT_DNS_PROBE_QUERY="example.com"
# WEM_AGENT_INTERNET_PROBE_TARGET="1.1.1.1"
# WEM_AGENT_HTTPS_PROBE_URL="https://example.com"
