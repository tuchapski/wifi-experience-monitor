# PostgreSQL development database
POSTGRES_DB=wifi_experience
POSTGRES_USER=wifi_experience
POSTGRES_PASSWORD=wifi-dev-password
POSTGRES_PORT=5432

# Server
SERVER_DATABASE_URL=postgresql+psycopg://wifi_experience:wifi-dev-password@127.0.0.1:5432/wifi_experience
SERVER_ENROLLMENT_TOKEN=wifi-dev-enrollment
SERVER_AGENT_OFFLINE_AFTER_SECONDS=15
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
WEM_RECORDING_STORAGE_ROOT=./storage/recordings

# Local development agent
WEM_AGENT_SERVER_URL=http://127.0.0.1:8000
WEM_AGENT_ENROLLMENT_TOKEN=wifi-dev-enrollment
WEM_AGENT_DATA_DIR=./data/agent
WEM_AGENT_NAME=sensor-local-01
WEM_AGENT_TYPE=sensor
WEM_AGENT_HEARTBEAT_INTERVAL_SECONDS=5
WEM_AGENT_REQUEST_TIMEOUT_SECONDS=10
WEM_AGENT_INTERFACE=
WEM_AGENT_STATE_INTERVAL_SECONDS=5

# Rolling telemetry
SERVER_TELEMETRY_RETENTION_HOURS=24
WEM_AGENT_TELEMETRY_SAMPLE_INTERVAL_SECONDS=1
WEM_AGENT_TELEMETRY_WINDOW_SECONDS=10
WEM_AGENT_TELEMETRY_SYNC_INTERVAL_SECONDS=5
WEM_AGENT_TELEMETRY_RETENTION_HOURS=24
